{
  "app": "Wikipedia",
  "tool_namespace": "wikipedia_db",
  "terminology": "Android function tool",
  "tools": [
    {
      "name": "add_page_to_reading_list",
      "description": "Inserts a new page into a reading list and updates the parent list's modification time and size in a single transaction.",
      "operation": "read_write",
      "parameters": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "integer",
            "description": "The database ID of the target reading list"
          },
          "wiki": {
            "type": "string",
            "description": "The wiki domain (e.g., 'enwiki')"
          },
          "lang": {
            "type": "string",
            "description": "Language code (e.g., 'en')"
          },
          "displayTitle": {
            "type": "string",
            "description": "The user-visible title of the page"
          },
          "apiTitle": {
            "type": "string",
            "description": "The normalized API title of the page"
          },
          "description": {
            "type": "string",
            "description": "Optional short description of the page"
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable"
          }
        },
        "required": [
          "listId",
          "wiki",
          "lang",
          "displayTitle",
          "apiTitle"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "pageId": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "pageId",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/org.wikipedia/databases/wikipedia.db"
      ],
      "safety": {}
    },
