{
  "app": "PhotoNote",
  "tool_namespace": "photonote_db",
  "terminology": "Android function tool",
  "tools": [
    {
      "name": "create_user",
      "description": "Inserts a new row into the 'users' table with the provided 'name' and 'user_name'. Sets 'post_count' to 0 and applies documented profile defaults.",
      "operation": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The display name of the user."
          },
          "user_name": {
            "type": "string",
            "description": "The unique username handle for the user."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": [
          "name",
          "user_name"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "description": "The auto-generated stable ID of the newly created user."
          },
          "name": {
            "type": "string",
            "description": "The display name of the user."
          },
          "user_name": {
            "type": "string",
            "description": "The unique username handle."
          },
          "post_count": {
            "type": "integer",
            "description": "Initialized post count, defaults to 0."
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/com.chartreux.photo_note/databases/PhotoNote.db"
      ],
      "safety": {}
    },
    {
      "name": "get_posts",
      "description": "Returns a list of posts matching the optional 'user_id' filter, or all posts if no filter is provided.",
      "operation": "read",
      "parameters": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "description": "Optional user ID filter to retrieve posts from a specific user."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": []
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "posts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "user_id": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                },
                "likes_count": {
                  "type": "integer"
                },
                "comments_count": {
                  "type": "integer"
                },
                "created_at": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "user_id",
                "text",
                "likes_count",
                "comments_count",
                "created_at"
              ]
            }
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/com.chartreux.photo_note/databases/PhotoNote.db"
      ],
      "safety": {}
    },
    {
      "name": "get_users",
      "description": "Returns a list of users matching the optional 'user_name' filter, or all users if no filter is provided.",
      "operation": "read",
      "parameters": {
        "type": "object",
        "properties": {
          "user_name": {
            "type": "string",
            "description": "Optional username filter to find a specific user."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": []
