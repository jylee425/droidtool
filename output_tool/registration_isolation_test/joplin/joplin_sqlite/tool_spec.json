{
  "app": "Joplin",
  "tool_namespace": "joplin_sqlite",
  "terminology": "Android function tool",
  "tools": [
    {
      "name": "create_folder",
      "description": "Inserts a new folder into the folders table. Validates parent folder, automatically sets timestamps and a matching unique textual ID.",
      "operation": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the new folder."
          },
          "parent_id": {
            "type": "string",
            "description": "Optional parent folder ID. If provided, must reference an existing folder row to prevent cyclic or invalid hierarchy."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the ADB executable."
          }
        },
        "required": [
          "title"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "The generated unique textual ID of the newly created folder."
          },
          "title": {
            "type": "string",
            "description": "The title of the created folder."
          },
          "parent_id": {
            "type": "string",
            "description": "The parent folder ID assigned to the folder."
          },
          "created_time": {
            "type": "integer",
            "description": "The creation timestamp set in the database's native scale."
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/net.cozic.joplin/databases/joplin.sqlite",
        "/data/data/net.cozic.joplin/databases/database.sqlite"
      ],
      "safety": {}
    },
    {
      "name": "list_folders",
      "description": "Lists all directories/folders found in the active Joplin SQLite database surface.",
      "operation": "read",
      "parameters": {
        "type": "object",
        "properties": {
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the ADB executable."
          }
        },
        "required": []
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "database_path": {
            "type": "string"
          },
          "folders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "parent_id": {
                  "type": "string"
                },
                "created_time": {
                  "type": "integer"
                },
                "updated_time": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "title",
                "parent_id",
                "created_time",
                "updated_time"
              ]
            }
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/net.cozic.joplin/databases/joplin.sqlite",
        "/data/data/net.cozic.joplin/databases/database.sqlite"
      ],
      "safety": {}
    },
    {
      "name": "search_notes",
      "description": "Searches for matching notes by searching the title/body text. Suppresses deleted or conflicted files unless specified.",
      "operation": "read",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Text query to match against note titles or bodies."
          },
          "parent_id": {
            "type": "string",
            "description": "Optional folder ID to filter notes within a specific notebook."
          },
          "include_deleted": {
            "type": "boolean",
            "default": false,
            "description": "Whether to include notes marked as deleted or conflicted."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the ADB executable."
          }
        },
        "required": []
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "parent_id": {
                  "type": "string"
                },
                "created_time": {
                  "type": "integer"
                },
                "updated_time": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "title",
                "parent_id",
                "created_time",
                "updated_time"
              ]
            }
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/net.cozic.joplin/databases/joplin.sqlite",
        "/data/data/net.cozic.joplin/databases/database.sqlite"
      ],
      "safety": {}
    }
  ]
}
