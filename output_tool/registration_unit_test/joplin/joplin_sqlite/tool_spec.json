    {
      "name": "update_note",
      "description": "Modifies properties of an existing note. Ensures atomic alignment of notes_normalized search helper if existing.",
      "operation": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The exact unique textual ID of the note to update."
          },
          "title": {
            "type": "string",
            "description": "Optional new title for the note."
          },
          "body": {
            "type": "string",
            "description": "Optional new body content."
          },
          "append": {
            "type": "boolean",
            "default": false,
            "description": "If true, appends the body text directly without separator."
          },
          "parent_id": {
            "type": "string",
            "description": "Optional new parent folder ID. Must reference an existing folder."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the ADB executable."
          }
        },
        "required": [
          "id"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "updated_time": {
            "type": "integer"
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/net.cozic.joplin/databases/joplin.sqlite",
        "/data/data/net.cozic.joplin/databases/database.sqlite"
