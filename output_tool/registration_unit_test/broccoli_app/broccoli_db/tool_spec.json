{
  "app": "Broccoli App",
  "tool_namespace": "broccoli_db",
  "terminology": "Android function tool",
  "tools": [
    {
      "name": "create_recipe",
      "description": "Insert a parent recipe row and its child ingredients/directions into the discovered database tables within a single transaction.",
      "operation": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title or name of the recipe."
          },
          "description": {
            "type": "string",
            "description": "A short summary or description of the recipe."
          },
          "servings": {
            "type": "string",
            "description": "Number of servings or portions (e.g., '4 servings')."
          },
          "prep_time": {
            "type": "string",
            "description": "Preparation time text (e.g., '20 mins')."
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of ingredients."
          },
          "directions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ordered list of preparation steps."
          },
          "image_name": {
            "type": "string",
            "description": "Optional image filename reference."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": [
          "title",
          "ingredients",
          "directions"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The newly generated unique identifier of the created recipe."
          },
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/com.flauschcode.broccoli/databases/broccoli"
      ],
      "safety": {}
    },
    {
      "name": "delete_recipe",
      "description": "Delete a recipe and its associated child rows (ingredients, directions) from the database.",
      "operation": "delete",
      "parameters": {
        "type": "object",
        "properties": {
          "recipe_id": {
            "type": "string",
            "description": "The unique identifier of the recipe to delete."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": [
          "recipe_id"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/com.flauschcode.broccoli/databases/broccoli"
      ],
      "safety": {}
