{
  "app": "VLC",
  "tool_namespace": "vlc_preferences",
  "terminology": "Android function tool",
  "tools": [
    {
      "name": "get_vlc_preferences",
      "description": "Parse the XML structure of the org.videolan.vlc_preferences.xml file and return documented user-facing settings structurally.",
      "operation": "read",
      "parameters": {
        "type": "object",
        "properties": {
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": []
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "video_hud_timeout_in_s": {
            "type": "integer",
            "description": "Timeout for the video HUD in seconds."
          },
          "app_theme": {
            "type": "string",
            "description": "The configured application theme."
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/org.videolan.vlc/shared_prefs/org.videolan.vlc_preferences.xml"
      ],
      "safety": {}
    },
    {
      "name": "set_vlc_preference",
      "description": "Update only documented keys with established value domains and preserve unrelated XML entries.",
      "operation": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "video_hud_timeout_in_s",
              "app_theme"
            ],
            "description": "The preference key to update."
          },
          "value": {
            "type": "string",
            "description": "The value to set (encoded as a string matching the XML preference type)."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": [
          "key",
          "value"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "True if the preference was successfully updated."
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/org.videolan.vlc/shared_prefs/org.videolan.vlc_preferences.xml"
      ],
      "safety": {}
    }
  ]
}
