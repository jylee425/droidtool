    {
      "name": "toggle_follow_user",
      "description": "Within a transaction: If 'follow' is true, inserts a row into the 'follows' table (if not already present). If 'follow' is false, deletes the corresponding row from the 'follows' table.",
      "operation": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "follower_id": {
            "type": "integer",
            "description": "The stable ID of the user who wants to follow/unfollow."
          },
          "followed_id": {
            "type": "integer",
            "description": "The stable ID of the user being followed/unfollowed."
          },
          "follow": {
            "type": "boolean",
            "description": "True to follow, False to unfollow."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": [
          "follower_id",
          "followed_id",
          "follow"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "follower_id": {
            "type": "integer"
          },
          "followed_id": {
            "type": "integer"
          },
          "following": {
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/com.chartreux.photonote/databases/PhotoNote.db"
      ],
      "safety": {}
