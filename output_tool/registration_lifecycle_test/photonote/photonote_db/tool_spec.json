    {
      "name": "toggle_like_post",
      "description": "Within a single transaction: If 'like' is true and no row exists in 'likes' for this user/post, inserts the row and increments 'likes_count' in 'posts'. If 'like' is false and a row exists, deletes the row and decrements 'likes_count' in 'posts'.",
      "operation": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "description": "The stable ID of the user performing the action."
          },
          "post_id": {
            "type": "integer",
            "description": "The stable ID of the post to like or unlike."
          },
          "like": {
            "type": "boolean",
            "description": "True to like the post, False to unlike it."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": [
          "user_id",
          "post_id",
          "like"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "user_id": {
            "type": "integer"
          },
          "post_id": {
            "type": "integer"
          },
          "liked": {
            "type": "boolean"
          },
          "likes_count": {
            "type": "integer"
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/com.chartreux.photonote/databases/PhotoNote.db"
