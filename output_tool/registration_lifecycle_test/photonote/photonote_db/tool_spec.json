  "tools": [
    {
      "name": "create_comment",
      "description": "Within a single transaction, inserts a new row into the 'comments' table and increments 'comments_count' in the 'posts' table for the corresponding post_id.",
      "operation": "write",
      "parameters": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "description": "The stable ID of the user commenting."
          },
          "post_id": {
            "type": "integer",
            "description": "The stable ID of the post being commented on."
          },
          "text": {
            "type": "string",
            "description": "The text content of the comment."
          },
          "adb_path": {
            "type": "string",
            "default": "adb",
            "description": "Path to the adb executable."
          }
        },
        "required": [
          "user_id",
          "post_id",
          "text"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "description": "The stable ID of the newly created comment."
          },
          "user_id": {
            "type": "integer",
            "description": "The ID of the commenting user."
          },
          "post_id": {
            "type": "integer",
            "description": "The ID of the commented post."
          },
          "text": {
            "type": "string",
            "description": "The text content of the comment."
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp of creation."
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "state_surfaces": [
        "/data/data/com.chartreux.photonote/databases/PhotoNote.db"
      ],
      "safety": {}
    },
